{
  "name": "hacksynapse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:web & npm run dev:backend",
    "dev:web": "npm run dev --workspace=web",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=web && npm run build --workspace=backend",
    "build:web": "npm run build --workspace=web",
    "build:backend": "npm run build --workspace=backend",
    "lint": "npm run lint --workspace=web && npm run lint --workspace=backend",
    "lint:web": "npm run lint --workspace=web",
    "lint:backend": "npm run lint --workspace=backend",
    "test": "npm run test --workspace=backend",
    "migrate": "npm run migrate --workspace=backend",
    "migrate:fresh": "npm run migrate:fresh --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "clean": "rimraf node_modules web/node_modules backend/node_modules",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
